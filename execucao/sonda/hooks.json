{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/sonda.py\" sync",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/sonda.py\" async",
            "async": true,
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
